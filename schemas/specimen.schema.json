{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fakegreg/specimen.schema.json",
  "title": "fakegreg specimen",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "kind",
    "surface",
    "prompt_path",
    "generator",
    "artifacts",
    "scores",
    "score_meta",
    "acceptance",
    "tags"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "reference",
        "candidate",
        "anti_example"
      ]
    },
    "surface": {
      "type": "string",
      "enum": [
        "landing_page",
        "dashboard",
        "docs_home",
        "pricing_page",
        "framework_component"
      ]
    },
    "prompt_path": {
      "type": "string",
      "minLength": 1
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "model",
        "skill",
        "provenance",
        "notes"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "skill": {
          "type": [
            "string",
            "null"
          ]
        },
        "generated_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "provenance": {
          "type": "string",
          "enum": [
            "real_api",
            "gallery_extract",
            "skill_reproduction",
            "synthetic_seed"
          ],
          "description": "How the specimen output was produced. Keep this honest — skill outputs must not be labeled as real Greg."
        },
        "notes": {
          "type": "string",
          "description": "Free-text provenance detail and caveats."
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_output_path",
        "screenshot_path",
        "analysis_path",
        "notes_path"
      ],
      "properties": {
        "raw_output_path": {
          "type": "string",
          "minLength": 1
        },
        "rendered_output_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "screenshot_path": {
          "type": "string",
          "minLength": 1
        },
        "analysis_path": {
          "type": "string",
          "minLength": 1
        },
        "notes_path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overall",
        "design_quality",
        "visual_polish",
        "narrative_copy",
        "implementation",
        "greg_fidelity"
      ],
      "properties": {
        "overall": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "design_quality": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "visual_polish": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "narrative_copy": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "implementation": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "greg_fidelity": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "score_meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scorer",
        "scored_at"
      ],
      "properties": {
        "scorer": {
          "type": "string",
          "enum": [
            "human",
            "skill",
            "script"
          ]
        },
        "scored_at": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string"
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_score",
        "required_sections",
        "required_visuals",
        "minimum_kickers",
        "analysis_shape"
      ],
      "properties": {
        "minimum_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "maximum_score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "required_sections": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "hero",
              "features",
              "code_block",
              "metrics",
              "cta"
            ]
          }
        },
        "required_visuals": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "canvas_or_svg"
            ]
          }
        },
        "minimum_kickers": {
          "type": "integer",
          "minimum": 0
        },
        "analysis_shape": {
          "type": "string",
          "enum": [
            "greg_ui_analysis_v1"
          ]
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
