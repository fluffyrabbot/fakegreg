{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fakegreg/eval-result.schema.json",
  "title": "fakegreg eval result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "prompt_set",
    "created_at",
    "mode",
    "results"
  ],
  "properties": {
    "prompt_set": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "report",
        "run"
      ]
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "skill_hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "count": {
          "type": "integer"
        },
        "passed": {
          "type": "integer"
        },
        "failed": {
          "type": "integer"
        },
        "mean_overall_score": {
          "type": [
            "number",
            "null"
          ]
        },
        "mean_candidate_score": {
          "type": [
            "number",
            "null"
          ]
        },
        "mean_reference_score": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "prompt_id",
          "specimen_id",
          "surface",
          "overall_score",
          "acceptance_passed"
        ],
        "properties": {
          "prompt_id": {
            "type": "string"
          },
          "specimen_id": {
            "type": "string"
          },
          "surface": {
            "type": "string"
          },
          "kind": {
            "type": [
              "string",
              "null"
            ]
          },
          "provenance": {
            "type": [
              "string",
              "null"
            ]
          },
          "scorer": {
            "type": [
              "string",
              "null"
            ]
          },
          "overall_score": {
            "type": "number"
          },
          "acceptance_passed": {
            "type": "boolean"
          },
          "analysis_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "output_path": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
